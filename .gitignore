# Python
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.venv/
.pytest_cache/
.ruff_cache/

# Local environment. Secrets live encrypted in secrets/, see .sops.yaml
.env
.envrc

# Nix
/result
/result-*
.direnv/

# Angular. frontend/.gitignore lists the same paths for a checkout of the
# frontend alone
/frontend/node_modules/
/frontend/dist/
/frontend/.angular/
/frontend/out-tsc/

# Local password files, which belong in secrets/ through sops
*.password
